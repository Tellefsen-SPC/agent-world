# Agent World — local environment (copy to .env; .env is gitignored, never committed)
#
# No Supabase URL or service-role key here. The Compass Supabase project is provisioned through
# Lovable, which does not expose either outside Lovable itself. Reads go through the Compass
# Worker's /ledger/scan route (worker/ledger-read.mjs — deploy it first, see worker/WIRING.md),
# over the same bearer token /events already uses. The Worker already holds the Supabase access.

# Notion — read 🎯 Engagement Milestones (U4) and Decision status (U6). Read only.
NOTION_TOKEN=
# Airtable HQ — read Pending Approval status (U6). Read only.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appixWl8C3bogLsvp
# Compass Worker — the build's own hooks post run events here (U2), and this same token now also
# authorizes reads via /ledger/scan (U3/U10). Same value as the Worker's EVENTS_BEARER_TOKEN secret.
EVENTS_URL=https://tellefsen-compass-mcp.christoffer-7e3.workers.dev/events
EVENTS_BEARER_TOKEN=
# Deep link for chat / Claude Project runs (U5) — the Tellefsen — Agent World Claude Project URL
CLAUDE_PROJECT_URL=https://claude.ai/project/01a06dba-fed2-7095-96e4-d78daa3310fe
# Adapter tunables (defaults shown)
WORLD_WINDOW_DAYS=14
WORLD_RUNNING_TTL_HOURS=2
WORLD_VIEWER_PRESET=owner
WORLD_TENANT=tellefsen
# U37: how long a read may take, body included (ms). A ledger scan or substrate read that runs past
# its deadline puts "Compass unavailable" on the strip; a spend, Notion or Airtable read that does
# is reported as a read error where its line or panel would be. The ledger scan runs 6–9 s on a normal day.
WORLD_LEDGER_TIMEOUT_MS=25000
# The 30-day background scan (raised hands for silent skills) reads about twice the window.
WORLD_LEDGER_LONG_TIMEOUT_MS=120000
# Every other read: Compass substrate and spend, Notion, Airtable.
WORLD_READ_TIMEOUT_MS=10000
# Standing test gate: the ZZTEST Alpha Pending Approval row (created 2026-09-06 via the Compass
# validated path) — scripts/zztest-seed.sh reads this
ZZTEST_PA_URL=https://airtable.com/appixWl8C3bogLsvp/tbleRnuppbr0wpsaM/recpYloZWYijWCO2T
# Notion project page id, so the build's own runs land on the Agent World plot (U2)
AGENT_WORLD_PROJECT_ID=3d1c0af9-c974-81ce-8a25-f4bdeadd54ab
